singularity {
    enabled = true
    autoMounts = true
    // GUI installations use SIFs with persistent Pangolin/snpEff overlays.
    // The wrapper prepares snpEff databases before analysis; tasks attach
    // overlays read-only. Legacy installations can still use the Singularity
    // profile's writable-tmpfs fallback without changing scientific commands.
}

// The ILLUMINA images, declared once.
//
// Two things read this map: the process directives below, which decide what
// each task actually runs in, and metadata_helpers.containerSpecs(), which
// decides what container_manifest.tsv claims the run used. Those used to be
// two hand-maintained lists of the same paths, so bumping a version here left
// the manifest asserting the old image - a provenance record quietly
// describing a run that never happened, which is the one thing it exists to
// prevent.
//
// Keys are image names and appear verbatim in the manifest. NANOPORE needs no
// entry here: it resolves its two images from params.base_container and
// params.clair3_container, which were already single declarations.
params {
    illumina_containers = [
        edirect:            "$projectDir/containers/edirect:1.1.0.sif",
        generate_consensus: "$projectDir/containers/generate_consensus:2.0.0.sif",
        fastp:              "$projectDir/containers/fastp:1.0.1.sif",
        samtools:           "$projectDir/containers/samtools:1.11.0.sif",
        mafft:              "$projectDir/containers/mafft:7.505_2.sif",
        picard:             "$projectDir/containers/picard:2.27.2_2.sif",
        intrahost_analysis: "$projectDir/containers/intrahost_analysis:1.1.0.sif",
        generate_plots:     "$projectDir/containers/generate_plots:2.0.0.sif",
        compiled_outputs:   "$projectDir/containers/compiled_outputs:1.1.0.sif",
        snpeff:             "$projectDir/containers/snpeff:5.0.sif",
        generate_report:    "$projectDir/containers/generate_report:1.1.0.sif",
        pangolin:           "$projectDir/containers/pangolin:4.4.sif",
        nextclade:          "$projectDir/containers/nextclade:3.18.sif"
    ]
}

// Closures, not GStrings: a "${params.x}" directive is resolved while this file
// is parsed, before -c files and command line parameters are merged, so an
// override would be reported and then ignored at execution. The same reason the
// NP_basecontainer and runClair3 directives in nextflow.config are closures.
//
// getOrDefault, not params.illumina_containers: Nextflow also evaluates every
// container closure once at startup, to fill workflow.container, and does so
// before it binds the config params (Session.init builds WorkflowMetadata a few
// lines ahead of binding.setParams, as of 26.04.6). A plain params.x read there
// finds nothing and prints "Access to undefined parameter" on every run, ILLUMINA
// and NANOPORE alike. getOrDefault reads the same map without that lookup, so the
// startup pass resolves to null quietly while tasks, which run once the params
// are bound, get exactly what they got before.
process {
    withName:prepareDatabase {
        container = { params.getOrDefault('illumina_containers', [:]).edirect }
    }
    withName:indexReferenceBWA {
        container = { params.getOrDefault('illumina_containers', [:]).generate_consensus }
    }
    withName:runFastp {
        container = { params.getOrDefault('illumina_containers', [:]).fastp }
    }
    withName:runIvar {
        container = { params.getOrDefault('illumina_containers', [:]).generate_consensus }
    }
    withName:align2ref {
        container = { params.getOrDefault('illumina_containers', [:]).generate_consensus }
    }
    withName:runAmpliconClipping {
        container = { params.getOrDefault('illumina_containers', [:]).samtools }
    }
    withName:runReadCounts {
        container = { params.getOrDefault('illumina_containers', [:]).intrahost_analysis }
    }
    withName:alignConsensus2Ref {
        container = { params.getOrDefault('illumina_containers', [:]).mafft }
    }
    withName:runPangolin {
        container = { params.getOrDefault('illumina_containers', [:]).pangolin }
        containerOptions = {
            def image = params.getOrDefault('illumina_containers', [:]).pangolin
            def overlay = image ? new File(image.toString()).parent + '/pangolin_4.4.overlay' : null
            overlay && new File(overlay).isFile() ? "--fakeroot --overlay '${overlay}:ro'" : ''
        }
    }
    withName:runNextClade {
        container = { params.getOrDefault('illumina_containers', [:]).nextclade }
    }
    withName:runPicard {
        container = { params.getOrDefault('illumina_containers', [:]).picard }
    }
    withName:runSnpEff {
        container = { params.getOrDefault('illumina_containers', [:]).snpeff }
        containerOptions = {
            def image = params.getOrDefault('illumina_containers', [:]).snpeff
            def overlay = image ? new File(image.toString()).parent + '/snpeff_5.0.overlay' : null
            overlay && new File(overlay).isFile() ? "--fakeroot --overlay '${overlay}:ro'" : ''
        }
    }
    withName:genFaIdx {
        container = { params.getOrDefault('illumina_containers', [:]).generate_consensus }
    }
    // GENPLOTS runs in both modes. For NANOPORE, getMappedReads,
    // getUnmappedReads and coveragePlot use the nanopore base image, which
    // carries samtools and bamdash, so a NANOPORE run needs no ILLUMINA image.
    // That is also what lets it run under -profile docker at all: the ILLUMINA
    // images are SIFs from the Sylabs library, with no Docker equivalent.
    withName:getMappedReads {
        container = {
            params.getOrDefault('mode', null) == 'NANOPORE'
                ? params.getOrDefault('base_container', null)
                : params.getOrDefault('illumina_containers', [:]).generate_consensus
        }
    }
    withName:getUnmappedReads {
        container = {
            params.getOrDefault('mode', null) == 'NANOPORE'
                ? params.getOrDefault('base_container', null)
                : params.getOrDefault('illumina_containers', [:]).generate_consensus
        }
    }
    withName:checkSnpEffDB {
        container = { params.getOrDefault('illumina_containers', [:]).snpeff }
        containerOptions = {
            def image = params.getOrDefault('illumina_containers', [:]).snpeff
            def overlay = image ? new File(image.toString()).parent + '/snpeff_5.0.overlay' : null
            overlay && new File(overlay).isFile() ? "--fakeroot --overlay '${overlay}:ro'" : ''
        }
    }
    withName:runVfReport {
        container = { params.getOrDefault('illumina_containers', [:]).generate_report }
    }
    // NANOPORE uses the base image here too; see getMappedReads above.
    withName:coveragePlot {
        container = {
            params.getOrDefault('mode', null) == 'NANOPORE'
                ? params.getOrDefault('base_container', null)
                : params.getOrDefault('illumina_containers', [:]).generate_plots
        }
    }
    withName:snpPlot {
        container = { params.getOrDefault('illumina_containers', [:]).generate_plots }
    }
    withName:compileOutputs {
        container = { params.getOrDefault('illumina_containers', [:]).compiled_outputs }
    }
    // The same image runReadCounts uses. It was built for this pair of
    // processes - bam-readcount for one, and the biopython/pandas/numpy
    // intrahost.py imports for the other - which is why it is named for the
    // analysis rather than for a tool.
    withName:runIntraHostScript {
        container = { params.getOrDefault('illumina_containers', [:]).intrahost_analysis }
    }
}
