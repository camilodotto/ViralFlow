Bootstrap: docker
From: debian:12-slim

%environment
    export PATH=$PATH:/usr/local/bin/micromamba:/usr/local/bin/mm:/usr/local/bin/mm/bin
    
%post
    set -e
    apt-get update
    apt-get install -y curl bzip2
    cd /usr/local
    rmdir bin
    curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/1.5.7 | tar -xvj bin/micromamba
    export MAMBA_ROOT_PREFIX=/usr/local/bin/mm
    eval "$(/usr/local/bin/micromamba shell hook -s posix)"
    /usr/local/bin/micromamba shell init -s bash -p /usr/local/bin/mm
    micromamba shell init --shell=bash --prefix=/usr/local/bin/mm
    micromamba activate
    micromamba config append channels conda-forge --env
    micromamba install -y -c bioconda -c conda-forge \
        python=3.11 usher=0.6.2 snakemake-minimal==9.19.0 \
        "snakemake-interface-common>=1.20.1,<1.23" "packaging>=24,<26" \
        "pandas>=2.3.1,<2.4" scikit-learn=1.7.1 \
        minimap2 gofasta ucsc-fatovcf procps-ng git pip \
        pangolin-data scorpio constellations "setuptools<81" wheel
    # Bioconda's pangolin recipe constrains sklearn <1.3, conflicting with
    # v4.4's Python requirement sklearn==1.7.1. Install the pinned application
    # from its upstream tag while keeping auxiliary tools/data in Conda.
    python -m pip install --no-build-isolation git+https://github.com/cov-lineages/pangolin.git@v4.4
    python -m pip check
    apt-get clean
    micromamba clean --all --yes
    rm -rf /var/lib/apt/lists/* /usr/share/man /usr/share/doc /usr/share/locale
